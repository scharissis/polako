# Built binaries
/polako
/cmd/polako/polako
/polako.exe
/dist/

# Eval runs: `claude plugin eval` writes results here, and the scaffold builds
# its scratch repo, stand-in gh and record dir in the runner's working directory.
/evals/results/

# Skill run artifacts: `implement-issue` writes PLAN.md into the worktree it
# works in, and every throwaway file — PR body, review diff dumps — under
# .polako-scratch/. Neither ships. The scratch dir also ignores itself, since
# the skill runs in repos without this line.
/PLAN.md
/.polako-scratch/

# Where `implement-issue` puts the worktree it creates per issue — anchored
# inside the checkout so `git worktree add` needs no `cd`, and dot-prefixed so
# `go vet ./...`/`go test ./...` skip it. Tracked here rather than left to
# `.git/info/exclude`, which a fresh clone does not have.
/.worktrees/

# Go
*.test
*.out

# Editors / OS
.DS_Store

# Python bytecode from the eval graders
__pycache__/
